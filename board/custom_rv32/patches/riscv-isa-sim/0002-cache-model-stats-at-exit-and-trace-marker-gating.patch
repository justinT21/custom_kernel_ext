+void cache_sim_t::print_stats(std::ostream& out)
+{
+  uint64_t accesses = read_accesses + write_accesses;
+  uint64_t misses = read_misses + write_misses;
+  float mr = accesses ? 100.0f*misses/accesses : 0.0f;
+
+  out << std::setprecision(3) << std::fixed;
+  out << name << " ";
+  out << "Bytes Read:            " << bytes_read << std::endl;
+  out << name << " ";
+  out << "Bytes Written:         " << bytes_written << std::endl;
+  out << name << " ";
+  out << "Read Accesses:         " << read_accesses << std::endl;
+  out << name << " ";
+  out << "Write Accesses:        " << write_accesses << std::endl;
+  out << name << " ";
+  out << "Read Misses:           " << read_misses << std::endl;
+  out << name << " ";
+  out << "Write Misses:          " << write_misses << std::endl;
+  out << name << " ";
+  out << "Writebacks:            " << writebacks << std::endl;
+  out << name << " ";
+  out << "Miss Rate:             " << mr << '%' << std::endl;
+  if (gate && window_insns) {
+    out << name << " ";
+    out << "Misses per 1K Insns:   " << 1000.0*misses/window_insns << std::endl;
+  }
 }
 
