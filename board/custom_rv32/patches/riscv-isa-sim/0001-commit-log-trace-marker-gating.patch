From: custom_rv32
Subject: [PATCH] commit log: optional gating on trace marker instructions

With SPIKE_TRACE_GATE set in the environment, --log-commits only prints
instructions from "addi x0, x0, 0x5a1" (trace on) through
"addi x0, x0, 0x5a0" (trace off), and flushes the log at trace off. Both
markers are RISC-V HINTs (no-ops), so the same markers can stay in code
that runs on real hardware. Without the variable, behavior is unchanged.

See docs/tracing.md in the custom_rv32 external tree.
---
--- a/riscv/execute.cc
+++ b/riscv/execute.cc
@@ -6,6 +6,7 @@
 #include "disasm.h"
 #include "decode_macros.h"
 #include <cassert>
+#include <cstdlib>
 
 static void commit_log_reset(processor_t* p)
 {
@@ -62,6 +63,23 @@
 
 static void commit_log_print_insn(processor_t *p, reg_t pc, insn_t insn)
 {
+  // With SPIKE_TRACE_GATE set, only log from the trace-on marker
+  // (addi x0, x0, 0x5a1) through the trace-off marker (addi x0, x0, 0x5a0),
+  // and flush at the trace-off marker so the window is complete on disk.
+  static const bool gate = getenv("SPIKE_TRACE_GATE") != nullptr;
+  static bool tracing = false;
+  bool window_end = false;
+  if (gate) {
+    if (insn.bits() == 0x5a100013)
+      tracing = true;
+    if (!tracing)
+      return;
+    if (insn.bits() == 0x5a000013) {
+      tracing = false;
+      window_end = true;
+    }
+  }
+
   FILE *log_file = p->get_log_file();
 
   auto& reg = p->get_state()->log_reg_write;
@@ -149,6 +167,8 @@
     commit_log_print_value(log_file, std::get<2>(item) << 3, std::get<1>(item));
   }
   fprintf(log_file, "\n");
+  if (window_end)
+    fflush(log_file);
 }
 
 inline void processor_t::update_histogram(reg_t pc)
